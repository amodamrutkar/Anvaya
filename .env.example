# Sutradhar — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# NEVER hard-code these values in source code.

# ---- API Runtime ----
# Directory where pipeline artifacts are stored.
# Falls back to contracts/fixtures/ if this directory is absent (fixture mode).
ARTIFACTS_DIR=artifacts

# Demo tamper mode — set to 1 only for live demo tamper-detection demonstration.
# Never enable in any non-demo context.
DEMO_TAMPER=0

# CORS origins for the web frontend (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ---- HMAC salt for federated query hashed matching ----
# Generated fresh at each API startup; leave blank to auto-generate.
FEDERATED_HMAC_SALT=

# ---- LLM (optional; default is offline/none) ----
# Set to "anthropic" or "gemini" to enable LLM extraction.
# Results are cached to disk. No network calls at demo time.
LLM_PROVIDER=none
ANTHROPIC_API_KEY=your-anthropic-key-here
GEMINI_API_KEY=your-gemini-key-here

# ---- Database ----
# SQLite paths (relative to services/api/)
APP_DB_PATH=app.db
STATE_POLICE_DB_PATH=state_police.db
MAHA_CYBER_DB_PATH=maha_cyber.db
CENTRAL_AGENCY_DB_PATH=central_agency.db

# ---- Dataset version ----
DATASET_VERSION=v1

# ---- API server ----
API_HOST=0.0.0.0
API_PORT=8000

# ---- Web frontend (set in apps/web/.env.local) ----
# VITE_API_BASE_URL=http://localhost:8000
# VITE_API_MODE=fixture
