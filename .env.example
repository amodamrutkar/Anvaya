# Sutradhar — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# NEVER hard-code secrets or credentials in source code.

# ---- Deployment & Runtime Mode ----
# Set to "production" in container or cloud environments; "development" for local work.
ENVIRONMENT=production

# ---- API Runtime & Storage ----
# Root path for container deployment (defaults to auto-detected repository root if unset)
APP_ROOT=/app

# Directory where pipeline artifacts are stored.
# Falls back to contracts/fixtures/ if this directory is absent (fixture mode).
ARTIFACTS_DIR=artifacts

# Demo tamper mode — 0 = tamper disabled (production default), 1 = enable /audit/dev/tamper for live demos.
# Never enable in any non-demo context.
DEMO_TAMPER=0

# ---- Authentication & RBAC (Controlled Deployment Mode) ----
# Retain development/demo authentication mode for controlled test deployments.
# A strong, non-default DEV_AUTH_SECRET is strictly required when ENVIRONMENT=production.
DEV_AUTH_ENABLED=1
DEV_AUTH_SECRET=generate-a-strong-random-secret-here
DEV_AUTH_TOKEN_TTL_SECONDS=3600

# ---- CORS Origins ----
# Comma-separated list of allowed origins.
# In unified reverse-proxy deployments, web and api share the same origin.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173

# ---- Federated Matching Salt ----
# Salt used for one-way HMAC-SHA256 hashing of identifiers across agency silos.
# Ensures zero raw PII crosses agency boundaries during cross-agency queries.
FEDERATED_HMAC_SALT=generate-a-strong-random-salt-here

# ---- Storage Architecture Notice ----
# Sutradhar currently runs on a high-performance in-memory graph intelligence store
# loaded at startup from canonical pipeline artifacts (artifacts/) and contracts (contracts/fixtures/).
# No external SQL or NoSQL database is required for this deployment.

# ---- Dataset version ----
DATASET_VERSION=v1

# ---- API server ----
API_HOST=0.0.0.0
API_PORT=8000

# ---- Web Frontend Routing ----
# Leave empty ("") for unified reverse-proxy deployments (relative routing).
# Set to "http://localhost:8000" only for standalone Vite development server.
VITE_API_BASE_URL=
