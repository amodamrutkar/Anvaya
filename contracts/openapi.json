  "components": {
    "schemas": {
      "Agency": {
        "type": "string",
        "enum": [
          "STATE_POLICE",
          "MAHA_CYBER",
          "CENTRAL_AGENCY"
        ],
        "title": "Agency"
      },
      "AlertAction": {
        "type": "string",
        "enum": [
          "CONFIRM",
          "DISMISS"
        ],
        "title": "AlertAction"
      },
      "DossierExportFormat": {
        "type": "string",
        "enum": [
          "JSON",
          "json",
          "PDF",
          "pdf"
        ],
        "title": "DossierExportFormat"
      },
      "DossierExportRequest": {
        "properties": {
          "confirm": {
            "type": "boolean",
            "title": "Confirm"
          },
          "export_format": {
            "$ref": "#/components/schemas/DossierExportFormat",
            "default": "json"
          }
        },
        "type": "object",
        "required": [
          "confirm"
        ],
        "title": "DossierExportRequest"
      },
      "DossierGenerateRequest": {
        "properties": {
          "community_id": {
            "type": "string",
            "title": "Community Id"
          }
        },
        "type": "object",
        "required": [
          "community_id"
        ],
        "title": "DossierGenerateRequest"
      },
      "FederatedQueryRequest": {
        "properties": {
          "querying_agency": {
            "$ref": "#/components/schemas/Agency"
          },
          "identifier_type": {
            "$ref": "#/components/schemas/IdentifierType"
          },
          "identifier_value": {
            "type": "string",
            "minLength": 1,
            "title": "Identifier Value"
          },
          "purpose": {
            "$ref": "#/components/schemas/QueryPurpose"
          },
          "case_ref": {
            "type": "string",
            "pattern": "^(CASE-[A-Z]{3}(-\\d{4})?-\\d{6}|ALR-\\d{6})$",
            "title": "Case Ref"
          }
        },
        "type": "object",
        "required": [
          "querying_agency",
          "identifier_type",
          "identifier_value",
          "purpose",
          "case_ref"
        ],
        "title": "FederatedQueryRequest"
      },
      "FederatedQueryResponse": {
        "properties": {
          "query_id": {
            "type": "string",
            "title": "Query Id"
          },
          "result": {
            "$ref": "#/components/schemas/FederatedResult"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          },
          "reason_code": {
            "$ref": "#/components/schemas/FederatedReasonCode"
          },
          "reason_text": {
            "type": "string",
            "title": "Reason Text"
          },
          "owning_agency_notified": {
            "type": "boolean",
            "title": "Owning Agency Notified"
          },
          "audit_seq": {
            "type": "integer",
            "title": "Audit Seq"
          }
        },
        "type": "object",
        "required": [
          "query_id",
          "result",
          "confidence",
          "reason_code",
          "reason_text",
          "owning_agency_notified",
          "audit_seq"
        ],
        "title": "FederatedQueryResponse"
      },
      "FederatedReasonCode": {
        "type": "string",
        "enum": [
          "OPEN_CASE_MATCH",
          "CLOSED_CASE_MATCH",
          "NO_RECORD",
          "AMBIGUOUS_IDENTITY"
        ],
        "title": "FederatedReasonCode"
      },
      "FederatedResult": {
        "type": "string",
        "enum": [
          "MATCH",
          "NO_MATCH",
          "MAYBE"
        ],
        "title": "FederatedResult"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IdentifierType": {
        "type": "string",
        "enum": [
          "PHONE",
          "ACCOUNT",
          "VEHICLE",
          "PERSON_NAME_FATHER"
        ],
        "title": "IdentifierType"
      },
      "KumbhAlertActionRequest": {
        "properties": {
          "action": {
            "$ref": "#/components/schemas/AlertAction"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "action"
        ],
        "title": "KumbhAlertActionRequest"
      },
      "QueryPurpose": {
        "type": "string",
        "enum": [
          "INVESTIGATION",
          "ALERT_VERIFICATION",
          "AUDIT"
        ],
        "title": "QueryPurpose"
      },
      "ReviewDecision": {
        "type": "string",
        "enum": [
          "CONFIRM",
          "REJECT"
        ],
        "title": "ReviewDecision"
      },
      "ReviewDecisionRequest": {
        "properties": {
          "decision": {
            "$ref": "#/components/schemas/ReviewDecision"
          },
          "reason": {
            "type": "string",
            "minLength": 3,
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "decision",
          "reason"
        ],
        "title": "ReviewDecisionRequest"
      },
      "UnlinkRequest": {
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 3,
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "reason"
        ],
        "title": "UnlinkRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}